rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    function isActiveTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveStudent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveParent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function hasTeacherAccess(data) {
      let path = /databases/$(database)/documents/teachingAssignmentAccess/$(request.auth.uid + '--' + data.academicYearId + '--' + data.classId + '--' + data.sectionId + '--' + data.subjectId);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.teacherUid == request.auth.uid
        && get(path).data.campusId == data.campusId;
    }

    function hasTeacherClassAccess(data) {
      let path = /databases/$(database)/documents/teacherClassAccess/$(request.auth.uid + '--' + data.academicYearId + '--' + data.classId + '--' + data.sectionId);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.teacherUid == request.auth.uid
        && get(path).data.campusId == data.campusId;
    }

    function hasStudentAccess(data) {
      let path = /databases/$(database)/documents/studentClassAccess/$(request.auth.uid + '--' + data.academicYearId + '--' + data.classId + '--' + data.sectionId);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.studentUserId == request.auth.uid
        && get(path).data.campusId == data.campusId;
    }

    function hasStudentSubmissionAccess(data, studentId) {
      let path = /databases/$(database)/documents/studentClassAccess/$(request.auth.uid + '--' + data.academicYearId + '--' + data.classId + '--' + data.sectionId);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.studentUserId == request.auth.uid
        && get(path).data.studentId == studentId;
    }

    function validLearningAttachments(data) {
      return data.attachmentPaths is list && data.attachmentPaths.size() <= 5;
    }

    function validAssignmentPublication(data) {
      return data.status != 'published'
        || (data.publishedAt is timestamp && data.dueAt is timestamp && data.dueAt > request.time);
    }

    function studentIsEnrolledInSession(studentId, sessionData) {
      let student = get(/databases/$(database)/documents/students/$(studentId)).data;
      let path = /databases/$(database)/documents/studentClassAccess/$(student.userId + '--' + sessionData.academicYearId + '--' + sessionData.classId + '--' + sessionData.sectionId);
      return student.active == true
        && exists(path)
        && get(path).data.active == true
        && get(path).data.studentId == studentId
        && get(path).data.studentUserId == student.userId
        && get(path).data.campusId == sessionData.campusId;
    }

    function validAttendanceSession(data) {
      return data.keys().hasAll([
          'campusId', 'academicYearId', 'classId', 'sectionId', 'sectionName',
          'subjectId', 'teacherId', 'date', 'periodLabel', 'status', 'createdBy'
        ])
        && data.keys().hasOnly([
          'campusId', 'academicYearId', 'classId', 'sectionId', 'sectionName',
          'subjectId', 'teacherId', 'date', 'periodLabel', 'status', 'createdBy',
          'submittedBy', 'submittedAt', 'correctedAt', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.campusId is string
        && data.academicYearId is string
        && data.classId is string
        && data.sectionId is string
        && data.sectionName is string
        && data.subjectId is string
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.periodLabel is string
        && data.periodLabel.size() <= 40
        && data.status in ['draft', 'submitted', 'corrected']
        && data.createdBy is string
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 300));
    }

    function validAttendanceRecord(data) {
      return data.keys().hasAll([
          'sessionId', 'campusId', 'studentId', 'status', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'sessionId', 'campusId', 'studentId', 'status', 'note', 'updatedBy',
          'updatedAt', 'createdAt'
        ])
        && data.sessionId is string
        && data.campusId is string
        && data.studentId is string
        && data.status in ['present', 'absent', 'late', 'excused']
        && data.updatedBy == request.auth.uid
        && (!data.keys().hasAny(['note']) || (data.note is string && data.note.size() <= 300));
    }

    match /campuses/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /academicYears/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /terms/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /classes/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /sections/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /subjects/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /students/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /teachers/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /enrollments/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /teachingAssignments/{recordId} {
      allow read, write: if isActiveAdmin();
    }
    match /teachingAssignmentAccess/{recordId} {
      allow read: if isActiveAdmin() || (isActiveTeacher() && resource.data.teacherUid == request.auth.uid);
      allow write: if isActiveAdmin();
    }
    match /studentClassAccess/{recordId} {
      allow read: if isActiveAdmin()
        || ((isActiveStudent() || isActiveParent()) && resource.data.studentUserId == request.auth.uid)
        || (isActiveTeacher() && hasTeacherClassAccess(resource.data));
      allow write: if isActiveAdmin();
    }
    match /teacherClassAccess/{recordId} {
      allow read: if isActiveAdmin() || (isActiveTeacher() && resource.data.teacherUid == request.auth.uid);
      allow write: if isActiveAdmin();
    }

    match /notes/{noteId} {
      allow create: if isActiveTeacher()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && hasTeacherAccess(request.resource.data)
        && request.resource.data.status in ['draft', 'published']
        && validLearningAttachments(request.resource.data)
        && (request.resource.data.status != 'published' || request.resource.data.publishedAt is timestamp);
      allow read: if isActiveAdmin()
        || (isActiveTeacher() && resource.data.authorId == request.auth.uid && hasTeacherAccess(resource.data))
        || (isActiveStudent() && resource.data.status == 'published' && hasStudentAccess(resource.data));
      allow update: if isActiveTeacher()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && hasTeacherAccess(request.resource.data)
        && request.resource.data.status in ['draft', 'published', 'archived']
        && validLearningAttachments(request.resource.data)
        && (request.resource.data.status != 'published' || request.resource.data.publishedAt is timestamp);
      allow delete: if isActiveAdmin() || (isActiveTeacher() && resource.data.authorId == request.auth.uid && resource.data.status == 'draft');
    }

    match /assignments/{assignmentId} {
      allow create: if isActiveTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && hasTeacherAccess(request.resource.data)
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.allowSubmissions is bool
        && validLearningAttachments(request.resource.data)
        && validAssignmentPublication(request.resource.data);
      allow read: if isActiveAdmin()
        || (isActiveTeacher() && resource.data.teacherId == request.auth.uid && hasTeacherAccess(resource.data))
        || (isActiveStudent() && resource.data.status in ['published', 'closed'] && hasStudentAccess(resource.data));
      allow update: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && hasTeacherAccess(request.resource.data)
        && request.resource.data.status in ['draft', 'published', 'closed']
        && request.resource.data.allowSubmissions is bool
        && validLearningAttachments(request.resource.data)
        && validAssignmentPublication(request.resource.data);
      allow delete: if isActiveAdmin() || (isActiveTeacher() && resource.data.teacherId == request.auth.uid && resource.data.status == 'draft');
    }

    function canSubmitToAssignment(assignmentId, studentId, studentUserId) {
      let assignmentPath = /databases/$(database)/documents/assignments/$(assignmentId);
      return isActiveStudent()
        && studentUserId == request.auth.uid
        && exists(assignmentPath)
        && get(assignmentPath).data.status == 'published'
        && get(assignmentPath).data.allowSubmissions == true
        && get(assignmentPath).data.dueAt is timestamp
        && get(assignmentPath).data.dueAt > request.time
        && hasStudentSubmissionAccess(get(assignmentPath).data, studentId);
    }

    match /assignmentSubmissions/{submissionId} {
      allow create: if canSubmitToAssignment(request.resource.data.assignmentId, request.resource.data.studentId, request.resource.data.studentUserId)
        && submissionId == request.resource.data.assignmentId + '--' + request.resource.data.studentId
        && request.resource.data.status == 'submitted'
        && request.resource.data.attachmentPaths is list
        && request.resource.data.attachmentPaths.size() <= 5;
      allow read: if isActiveAdmin()
        || (isActiveStudent() && resource.data.studentUserId == request.auth.uid)
        || (isActiveTeacher()
          && exists(/databases/$(database)/documents/assignments/$(resource.data.assignmentId))
          && get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.teacherId == request.auth.uid
          && hasTeacherAccess(get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data));
      allow update: if canSubmitToAssignment(request.resource.data.assignmentId, request.resource.data.studentId, request.resource.data.studentUserId)
        && submissionId == request.resource.data.assignmentId + '--' + request.resource.data.studentId
        && resource.data.studentId == request.resource.data.studentId
        && resource.data.assignmentId == request.resource.data.assignmentId
        && resource.data.studentUserId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.attachmentPaths is list
        && request.resource.data.attachmentPaths.size() <= 5;
      allow delete: if isActiveAdmin();
    }

    match /attendanceSessions/{recordId} {
      allow create: if isActiveAdmin()
        || (isActiveTeacher()
          && validAttendanceSession(request.resource.data)
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'draft'
          && hasTeacherAccess(request.resource.data));
      allow read: if isActiveAdmin()
        || (isActiveTeacher() && resource.data.teacherId == request.auth.uid && hasTeacherAccess(resource.data))
        || (isActiveStudent() && resource.data.status in ['submitted', 'corrected'] && hasStudentAccess(resource.data));
      allow update: if isActiveAdmin()
        || (isActiveTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == request.auth.uid
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && hasTeacherAccess(resource.data)
          && hasTeacherAccess(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'submittedBy', 'correctedAt', 'updatedAt'])
          && request.resource.data.campusId == resource.data.campusId
          && request.resource.data.academicYearId == resource.data.academicYearId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.sectionId == resource.data.sectionId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.date == resource.data.date
          && request.resource.data.periodLabel == resource.data.periodLabel
          && request.resource.data.status in ['draft', 'submitted', 'corrected']
          && (request.resource.data.status != 'submitted' || (request.resource.data.submittedBy == request.auth.uid && request.resource.data.submittedAt is timestamp))
          && (request.resource.data.status != 'corrected' || request.resource.data.correctedAt is timestamp));
      allow delete: if isActiveAdmin();
    }

    match /attendanceRecords/{recordId} {
      function sessionPath(sessionId) {
        return /databases/$(database)/documents/attendanceSessions/$(sessionId);
      }
      function teacherCanEditSession(sessionId) {
        return exists(sessionPath(sessionId))
          && get(sessionPath(sessionId)).data.teacherId == request.auth.uid
          && hasTeacherAccess(get(sessionPath(sessionId)).data);
      }
      allow create: if isActiveAdmin()
        || (isActiveTeacher()
          && validAttendanceRecord(request.resource.data)
          && teacherCanEditSession(request.resource.data.sessionId)
          && get(sessionPath(request.resource.data.sessionId)).data.status == 'draft'
          && request.resource.data.campusId == get(sessionPath(request.resource.data.sessionId)).data.campusId
          && studentIsEnrolledInSession(request.resource.data.studentId, get(sessionPath(request.resource.data.sessionId)).data));
      allow read: if isActiveAdmin()
        || (isActiveTeacher() && teacherCanEditSession(resource.data.sessionId))
        || (isActiveStudent()
          && exists(sessionPath(resource.data.sessionId))
          && get(sessionPath(resource.data.sessionId)).data.status in ['submitted', 'corrected']
          && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.userId == request.auth.uid
          && studentIsEnrolledInSession(resource.data.studentId, get(sessionPath(resource.data.sessionId)).data));
      allow update: if isActiveAdmin()
        || (isActiveTeacher()
          && validAttendanceRecord(request.resource.data)
          && resource.data.sessionId == request.resource.data.sessionId
          && resource.data.studentId == request.resource.data.studentId
          && resource.data.campusId == request.resource.data.campusId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedBy', 'updatedAt'])
          && teacherCanEditSession(resource.data.sessionId)
          && get(sessionPath(resource.data.sessionId)).data.status in ['submitted', 'corrected']
          && studentIsEnrolledInSession(resource.data.studentId, get(sessionPath(resource.data.sessionId)).data));
      allow delete: if isActiveAdmin();
    }

    match /auditLogs/{recordId} {
      allow read: if isActiveAdmin() || (isActiveTeacher() && resource.data.actorUserId == request.auth.uid);
      allow create: if isActiveAdmin() || (isActiveTeacher() && request.resource.data.actorUserId == request.auth.uid);
      allow update, delete: if isActiveAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}